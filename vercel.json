{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python scripts/build_static.py",
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{server.py,database.py,learning.py}"
    }
  },
  "rewrites": [
    {"source": "/api/:path*", "destination": "/api/index?_route=:path*"}
  ],
  "headers": [
    {"source": "/learning.js", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
    {"source": "/practice-sync.js", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
    {"source": "/account.js", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}
  ]
}
